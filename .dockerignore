# Stuff we never want in a build context — keeps the build small and
# prevents the build from invalidating on incidental changes.
**/.git
**/.git/**
**/.DS_Store

# Rust / Tauri
src-tauri/target
src-tauri/Cargo.lock.bak

# Node / Vite
**/node_modules
**/.vite
**/.cache
# Keep the root dist/ for Docker build (pre-built frontend)

# Tooling artefacts
**/.idea
**/.vscode
**/.vscode/**
**/coverage
**/playwright-report
**/test-results

# Logs and env
**/*.log
.env
.env.*
!.env.example

# This repo's own "scratch" / dev-only paths
dev/preview
dev/test-import.mjs
dev/web.mjs
dev/TEST_REPORT.md
dev/cluster

# Tauri icons are mounted at build time, not needed in the
# front-end-only context — but harmless if included.
# (left in: icons/128x128.png is also used as the favicon)

# This file itself
Dockerfile
.dockerignore
docker-compose*.yml
.github

# Big test fixtures / mock data
# ── CAREFUL with src-tauri/src/* — k7s_lib's lib.rs declares
# `pub mod mcp;` and `pub mod web;` for the feature-gated modules
# in src/mcp/ and src/web/. If we exclude those directories from
# the build context, the compile dies with:
#   error[E0583]: file not found for module `mcp`
#   error[E0583]: file not found for module `web`
# The `web` and `mcp` features in Cargo.toml gate which code gets
# *compiled into* the binary, but the source files must still be
# present in the build context.
src-tauri/examples
docs/screenshots
