# Stuff we never want in a build context — keeps the build small and
# prevents the build from invalidating on incidental changes.
**/.git
**/.git/**
**/.DS_Store

# Rust / Tauri
src-tauri/target
src-tauri/Cargo.lock.bak

# Node / Vite
**/node_modules
**/dist
**/.vite
**/.cache

# Tooling artefacts
**/.idea
**/.vscode
**/.vscode/**
**/coverage
**/playwright-report
**/test-results

# Logs and env
**/*.log
.env
.env.*
!.env.example

# This repo's own "scratch" / dev-only paths
dev/preview
dev/test-import.mjs
dev/web.mjs
dev/TEST_REPORT.md
dev/cluster

# Tauri icons are mounted at build time, not needed in the
# front-end-only context — but harmless if included.
# (left in: icons/128x128.png is also used as the favicon)

# This file itself
Dockerfile
.dockerignore
docker-compose*.yml
.github

# Big test fixtures / mock data
# ── CAREFUL with src-tauri/src/bin/ — that directory holds
# k7s-web.rs and k7s-mcp.rs, the [[bin]] entry-points referenced
# from Cargo.toml. Excluding it makes `cargo build --bin k7s-web`
# fail with: "can't find bin `k7s-web` at path
# /src/src-tauri/src/bin/k7s-web.rs".
src-tauri/examples
src-tauri/src/mcp
src-tauri/src/web
docs/screenshots
