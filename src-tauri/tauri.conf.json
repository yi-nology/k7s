{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k7s",
  "version": "0.1.0",
  "identifier": "com.k7s.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "k7s",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "k7s - Kubernetes cluster manager",
    "longDescription": "k7s is a cross-platform Kubernetes cluster manager built with Tauri and Rust. Supports macOS and Linux."
  }
}
