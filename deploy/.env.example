# k7s Docker Compose Configuration
# Copy this file to .env and modify as needed

# ── Network exposure ─────────────────────────────────────────────

# Host bind address for the published port (default: 127.0.0.1, loopback-only).
# 0.0.0.0 exposes k7s-web to the LAN — ONLY together with a strong
# K7S_WEB_TOKEN and a TLS-terminating reverse proxy in front
# (k7s-web itself speaks plaintext HTTP).
#K7S_PORT_BIND=127.0.0.1

# Port to expose k7s web interface (default: 8080)
K7S_PORT=8080

# ── Auth ─────────────────────────────────────────────────────────

# Bearer token required by API and MCP clients on EVERY request,
# including http://<host>:<port>/mcp, /api/events and /api/status.
# Required for non-loopback binds; use a strong random secret:
#   openssl rand -base64 32
# If unset, k7s-web generates one into the k7s-data volume
# (`docker exec k7s-web cat /data/web-token`).
#K7S_WEB_TOKEN=

# Separate bearer token for the AI webhook endpoints (/hooks/*).
# Leave unset to keep webhooks disabled.
#K7S_HOOK_TOKEN=

# Extra allowed CORS origins (comma-separated), e.g. a browser SPA
# served from another origin. Leave empty unless you serve a browser
# client elsewhere.
#K7S_ALLOWED_ORIGINS=

# ── Misc ─────────────────────────────────────────────────────────

# Path to kubeconfig file (default: ~/.kube/config)
# KUBECONFIG=~/.kube/config

# Rust log level (default: info)
# Options: error, warn, info, debug, trace
RUST_LOG=info
